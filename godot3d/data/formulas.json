{
  "math.g6.mutlak": {"tr": "Mutlak değer: sayım 0'a uzaklığı",
    "en": "Absolute value: distance to zero", "fa": "قدر مطلق: فاصله تا صفر",
    "example": "|-8| = 8"},
  "math.g6.carpanlar": {"tr": "Çarpanlar: en büyük ortak bölen küçük parçalara",
    "en": "GCD: the greatest shared divisor", "fa": "ب.م.م: بزرگ‌ترین مقسوم‌علیه مشترک",
    "example": "EBOB(12,18)=6"},
  "math.g6.kuvvet": {"tr": "Üs: a×a×a = a³", "en": "Power: a×a×a = a³",
    "fa": "توان: ضرب‌های پشت سر هم", "example": "5³=125"},
  "math.g6.bolme": {"tr": "Bölüm × Bölen = Bölünen",
    "en": "quotient × divisor = dividend", "fa": "خارج‌قسمت × مقسوم = مقسوم‌علیه",
    "example": "42/6=7"},
  "math.g6.kesirler": {"tr": "Kesir = pay/payda",
    "en": "fraction = numerator/denominator", "fa": "کسر = صورت/مخرج",
    "example": "3/4+1/4=1"},
  "math.g6.oran-oranti": {"tr": "Oran: iki büyüklüğün bölümü",
    "en": "ratio: compare two quantities", "fa": "نسبت: مقایسهٔ دو مقدار", "example": "6:2=3:1"},
  "math.g6.yuzdeler": {"tr": "Yüzde: yüzdeki pay",
    "en": "percent: parts per hundred", "fa": "درصد: سهم از صد", "example": "25% = 1/4"},
  "math.g6.ondenlik": {"tr": "Ondalık: virgülün sağı ondalık",
    "en": "decimal fractions after comma", "fa": "اعشار: بعد از ویرگول", "example": "0,5=1/2"},
  "math.g6.kati-cisimler": {"tr": "Dikdörtgen prizma hacmi: a×b×c",
    "en": "box volume: a×b×c", "fa": "حجم: ضرب سه ضلع", "example": "2×3×4=24"},
  "math.g7.tamsayilar": {"tr": "Negatif ekleme: -3 + 8 = 5",
    "en": "add negatives: -3+8=5", "fa": "جمع اعداد منفی", "example": "(-2)×(-4)=8"},
  "math.g7.sayilar-desenler": {"tr": "Desen: fark farkı sabit → üçgen sayıları",
    "en": "pattern: growing constant gaps", "fa": "الگو: اختلاف ثابتِ در حال رشد",
    "example": "1,3,6,10,15…"},
  "math.g7.rasyonel": {"tr": "Rasyonel: p/q",
    "en": "rational number: p/q", "fa": "گویا: p/q", "example": "1/2+1/3=5/6"},
  "math.g7.kuvvet": {"tr": "Üs toplama: 2³ + 2³ = 2×2³",
    "en": "same bases add nicely", "fa": "جمع توان‌های هم‌مبنا", "example": "2³+2³=16"},
  "math.g8.carpanlar": {"tr": "EBOB: سر دفتر مشخصه",
    "en": "GCD of big numbers via factors", "fa": "ب.م.م از تحلیل", "example": "EBOB(48,36)=12"},
  "math.g8.uslu": {"tr": "a^m × a^n = a^(m+n)",
    "en": "multiply same bases → add powers", "fa": "ضرب توان‌های هم‌مبنا = جمع توان‌ها",
    "example": "2³×2²=2⁵"},
  "math.g8.karekoklu": {"tr": "√(ab)=√a·√b",
    "en": "square root of product", "fa": "ریشهٔ حاصل‌ضرب = حاصل‌ضرب ریشه‌ها",
    "example": "√80=4√5"},
  "math.g8.ozdeslik": {"tr": "(a+b)²=a²+2ab+b²",
    "en": "square of a sum identity", "fa": "مرتبهٔ توان‌دومِ مجموع",
    "example": "101²=10201"},
  "math.g8.bah.dogrusal": {"tr": "ax+b=c → x=(c-b)/a",
    "en": "linear equation → isolate x", "fa": "معادلهٔ خطی: x را تنها کن",
    "example": "2x+6=14→x=4"},
  "physics.g6.guz.basesla-madde": {"tr": "Yoğunluk = Kütle / Hacim",
    "en": "density = mass / volume", "fa": "چگالی = جرم ÷ حجم",
    "example": "200g/100cm³=2"},
  "physics.g7.guz.madde-islecimi": {"tr": "Katı mı sıvı mı? d karşılaştır",
    "en": "float? compare densities", "fa": "شناوری: مقایسهٔ چگالی", "example": "0,8<1 → yüzer"},
  "physics.g8.guz.basinc": {"tr": "P = Kuvvet / Alan",
    "en": "pressure = force / area", "fa": "فشار = نیرو/سطح", "example": "100N/2m²=50Pa"},
  "physics.g8.guz.elektrik": {"tr": "V = I × R",
    "en": "Ohm's law", "fa": "قانون اُهم", "example": "20Ω×1A=20V"}
}
