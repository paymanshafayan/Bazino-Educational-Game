; Godot 4.3 — Bazino 3D: Ada'nın Sırrı (Action-Adventure, Third-Person)
; نسخهٔ سه‌بعدیِ هم‌خانوادهٔ godot/ (2D) — مشتق از همان GDD، بدون تغییر در آن
config_version=5

[application]
config/name="Bazino 3D: Ada'nın Sırrı"
run/main_scene="res://scenes/main3d.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]
Api="*res://scripts/net/api.gd"
Telemetry="*res://scripts/net/telemetry.gd"
SaveData="*res://scripts/core/save.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.029, 0.035, 0.07, 1)

[physics]
3d/default_gravity=24.0

[internationalization]
locale/fallback="tr"
locale/translations=PackedStringArray("res://data/i18n.csv")
